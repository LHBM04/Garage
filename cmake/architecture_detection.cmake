set(GARAGE_ARCHITECTURE_X64 FALSE)
set(GARAGE_ARCHITECTURE_ARM64 FALSE)

if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(GARAGE_TARGET_PROCESSOR "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
elseif(APPLE AND CMAKE_OSX_ARCHITECTURES)
    set(GARAGE_TARGET_PROCESSOR "${CMAKE_OSX_ARCHITECTURES}")
else()
    set(GARAGE_TARGET_PROCESSOR "${CMAKE_SYSTEM_PROCESSOR}")
endif()

string(TOLOWER "${GARAGE_TARGET_PROCESSOR}" GARAGE_TARGET_PROCESSOR)

if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "[Garage] Only 64-bit x64 and ARM64 architectures are supported. Detected: ${GARAGE_TARGET_PROCESSOR} (${CMAKE_SIZEOF_VOID_P} bytes pointer)")
elseif(GARAGE_TARGET_PROCESSOR MATCHES "^(amd64|x86_64|x64)$")
    set(GARAGE_ARCHITECTURE_X64 TRUE)
    set(GARAGE_ARCHITECTURE "x64")
elseif(GARAGE_TARGET_PROCESSOR MATCHES "^(arm64|aarch64)$")
    set(GARAGE_ARCHITECTURE_ARM64 TRUE)
    set(GARAGE_ARCHITECTURE "ARM64")
else()
    message(FATAL_ERROR "[Garage] Only x64 and ARM64 architectures are supported. Detected: ${GARAGE_TARGET_PROCESSOR}")
endif()

message(STATUS "[Garage] Detected Architecture: ${GARAGE_ARCHITECTURE}")
