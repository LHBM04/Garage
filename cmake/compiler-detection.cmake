set(GARAGE_COMPILER_MSVC FALSE)
set(GARAGE_COMPILER_CLANG FALSE)
set(GARAGE_COMPILER_GCC FALSE)
set(GARAGE_COMPILER_APPLE_CLANG FALSE)

if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(GARAGE_COMPILER_MSVC TRUE)
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "19.29")
        message(FATAL_ERROR "[Garage] MSVC 19.29 (Visual Studio 2019 16.10) or later is required for C++20 support.")
    endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    set(GARAGE_COMPILER_CLANG TRUE)
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "14.0")
        message(FATAL_ERROR "[Garage] Clang 14.0 or later is required for C++20 support.")
    endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
    set(GARAGE_COMPILER_APPLE_CLANG TRUE)
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "14.0")
        message(FATAL_ERROR "[Garage] AppleClang 14.0 or later is required for C++20 support.")
    endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(GARAGE_COMPILER_GCC TRUE)
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "11.0")
        message(FATAL_ERROR "[Garage] GCC 11.0 or later is required for C++20 support.")
    endif()
else()
    message(WARNING "[Garage] Untested C++ compiler detected: ${CMAKE_CXX_COMPILER_ID} (${CMAKE_CXX_COMPILER_VERSION})")
endif()

message(STATUS "[Garage] Detected C++ Compiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(STATUS "[Garage] Compiler Mode: clang-cl (MSVC-compatible)")
endif()
