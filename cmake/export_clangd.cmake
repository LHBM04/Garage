cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED GARAGE_BUILD_DIR OR NOT DEFINED GARAGE_DATABASE)
    message(FATAL_ERROR "[Garage] GARAGE_BUILD_DIR and GARAGE_DATABASE are required.")
endif()

if(DEFINED GARAGE_NATIVE_DATABASE AND EXISTS "${GARAGE_NATIVE_DATABASE}")
    file(COPY_FILE "${GARAGE_NATIVE_DATABASE}" "${GARAGE_DATABASE}" ONLY_IF_DIFFERENT)
    message(STATUS "[Garage] Published native compilation database from ${GARAGE_BUILD_DIR}")
    return()
endif()

function(garage_json_string output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set("${output}" "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(garage_append_argument output array value)
    garage_json_string(quoted "${value}")
    string(JSON length LENGTH "${array}")
    string(JSON result SET "${array}" "${length}" "${quoted}")
    set("${output}" "${result}" PARENT_SCOPE)
endfunction()

set(reply_dir "${GARAGE_BUILD_DIR}/.cmake/api/v1/reply")
file(GLOB indexes "${reply_dir}/index-*.json")
if(NOT indexes)
    message(FATAL_ERROR "[Garage] No CMake File API response. Configure this build directory first.")
endif()
list(SORT indexes)
list(GET indexes -1 index_file)
file(READ "${index_file}" index)

foreach(kind IN ITEMS codemodel toolchains)
    if(kind STREQUAL "codemodel")
        set(version 2)
    else()
        set(version 1)
    endif()
    string(JSON reply_file ERROR_VARIABLE reply_error GET "${index}"
        reply client-garage-clangd "${kind}-v${version}" jsonFile)
    if(reply_error)
        message(FATAL_ERROR "[Garage] Missing ${kind} reply. Reconfigure after enabling clangd integration.")
    endif()
    file(READ "${reply_dir}/${reply_file}" "${kind}")
endforeach()

string(JSON source_root GET "${codemodel}" paths source)
string(JSON configuration_count LENGTH "${codemodel}" configurations)
set(configuration_index -1)
math(EXPR configuration_last "${configuration_count} - 1")
foreach(i RANGE 0 "${configuration_last}")
    string(JSON name GET "${codemodel}" configurations "${i}" name)
    if(name STREQUAL GARAGE_CONFIG)
        set(configuration_index "${i}")
        break()
    endif()
endforeach()
if(configuration_index LESS 0)
    message(FATAL_ERROR "[Garage] Configuration '${GARAGE_CONFIG}' is not present in this File API response.")
endif()

string(JSON target_count LENGTH "${codemodel}" configurations "${configuration_index}" targets)
math(EXPR target_last "${target_count} - 1")
set(target "")
foreach(i RANGE 0 "${target_last}")
    string(JSON name GET "${codemodel}" configurations "${configuration_index}" targets "${i}" name)
    if(name STREQUAL "Garage")
        string(JSON target_file GET "${codemodel}" configurations "${configuration_index}" targets "${i}" jsonFile)
        file(READ "${reply_dir}/${target_file}" target)
        break()
    endif()
endforeach()
if(NOT target)
    message(FATAL_ERROR "[Garage] The Garage target was not found; the previous database is unchanged.")
endif()

string(JSON toolchain_count LENGTH "${toolchains}" toolchains)
math(EXPR toolchain_last "${toolchain_count} - 1")
foreach(i RANGE 0 "${toolchain_last}")
    string(JSON language GET "${toolchains}" toolchains "${i}" language)
    if(language STREQUAL "CXX")
        string(JSON compiler GET "${toolchains}" toolchains "${i}" compiler path)
        string(JSON compiler_id GET "${toolchains}" toolchains "${i}" compiler id)
        break()
    endif()
endforeach()
if(NOT DEFINED compiler)
    message(FATAL_ERROR "[Garage] The C++ compiler was not found in the File API response.")
endif()
get_filename_component(compiler_name "${compiler}" NAME)
if(compiler_id STREQUAL "MSVC" OR compiler_name MATCHES "^(clang-cl|cl)(\\.exe)?$")
    set(msvc_driver TRUE)
    set(include_flag /I)
    set(define_flag /D)
    set(compile_flag /c)
else()
    set(msvc_driver FALSE)
    set(include_flag -I)
    set(define_flag -D)
    set(compile_flag -c)
endif()

set(database "[]")
string(JSON source_count LENGTH "${target}" sources)
math(EXPR source_last "${source_count} - 1")
foreach(i RANGE 0 "${source_last}")
    string(JSON group_index ERROR_VARIABLE group_error GET "${target}" sources "${i}" compileGroupIndex)
    if(group_error)
        continue()
    endif()
    string(JSON generated ERROR_VARIABLE generated_error GET "${target}" sources "${i}" isGenerated)
    if(NOT generated_error AND generated)
        continue()
    endif()
    string(JSON group GET "${target}" compileGroups "${group_index}")
    string(JSON language GET "${group}" language)
    if(NOT language STREQUAL "CXX")
        continue()
    endif()
    string(JSON source_file GET "${target}" sources "${i}" path)
    cmake_path(ABSOLUTE_PATH source_file BASE_DIRECTORY "${source_root}" NORMALIZE)
    set(arguments "[]")
    garage_append_argument(arguments "${arguments}" "${compiler}")
    if(DEFINED GARAGE_COMPILER_TARGET AND NOT GARAGE_COMPILER_TARGET STREQUAL "")
        garage_append_argument(arguments "${arguments}" "--target=${GARAGE_COMPILER_TARGET}")
    endif()

    string(JSON fragment_count ERROR_VARIABLE fragment_error LENGTH "${group}" compileCommandFragments)
    if(NOT fragment_error AND fragment_count GREATER 0)
        math(EXPR fragment_last "${fragment_count} - 1")
        foreach(j RANGE 0 "${fragment_last}")
            string(JSON fragment GET "${group}" compileCommandFragments "${j}" fragment)
            if(msvc_driver)
                separate_arguments(fragment_args WINDOWS_COMMAND "${fragment}")
            else()
                separate_arguments(fragment_args UNIX_COMMAND "${fragment}")
            endif()
            foreach(argument IN LISTS fragment_args)
                garage_append_argument(arguments "${arguments}" "${argument}")
            endforeach()
        endforeach()
    endif()

    foreach(member IN ITEMS includes defines)
        string(JSON count ERROR_VARIABLE member_error LENGTH "${group}" "${member}")
        if(member_error OR count EQUAL 0)
            continue()
        endif()
        math(EXPR last "${count} - 1")
        foreach(j RANGE 0 "${last}")
            if(member STREQUAL "includes")
                string(JSON value GET "${group}" includes "${j}" path)
                string(JSON system ERROR_VARIABLE system_error GET "${group}" includes "${j}" isSystem)
                if(NOT msvc_driver AND NOT system_error AND system)
                    garage_append_argument(arguments "${arguments}" -isystem)
                    garage_append_argument(arguments "${arguments}" "${value}")
                else()
                    garage_append_argument(arguments "${arguments}" "${include_flag}${value}")
                endif()
            else()
                string(JSON value GET "${group}" defines "${j}" define)
                garage_append_argument(arguments "${arguments}" "${define_flag}${value}")
            endif()
        endforeach()
    endforeach()
    garage_append_argument(arguments "${arguments}" "${compile_flag}")
    garage_append_argument(arguments "${arguments}" "${source_file}")
    garage_json_string(directory_json "${GARAGE_BUILD_DIR}")
    garage_json_string(file_json "${source_file}")
    set(entry "{}")
    string(JSON entry SET "${entry}" directory "${directory_json}")
    string(JSON entry SET "${entry}" file "${file_json}")
    string(JSON entry SET "${entry}" arguments "${arguments}")
    string(JSON entry_count LENGTH "${database}")
    string(JSON database SET "${database}" "${entry_count}" "${entry}")
endforeach()
string(JSON entry_count LENGTH "${database}")
if(entry_count EQUAL 0)
    message(FATAL_ERROR "[Garage] No C++ sources were exported; the previous database is unchanged.")
endif()
file(WRITE "${GARAGE_DATABASE}.tmp" "${database}\n")
file(RENAME "${GARAGE_DATABASE}.tmp" "${GARAGE_DATABASE}")
message(STATUS "[Garage] Exported ${entry_count} clangd commands for ${GARAGE_CONFIG} from ${GARAGE_BUILD_DIR}")
