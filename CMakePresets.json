{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}\\scripts\\buildsystems\\vcpkg.cmake"
      }
    },
    {
      "name": "x64-debug-static",
      "inherits": "base",
      "binaryDir": "${sourceDir}\\build\\debug-x64-static",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release-static",
      "inherits": "base",
      "binaryDir": "${sourceDir}\\build\\release-x64-static",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-debug-shared",
      "inherits": "base",
      "binaryDir": "${sourceDir}\\build\\debug-x64-shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release-shared",
      "inherits": "base",
      "binaryDir": "${sourceDir}\\build\\release-x64-shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}